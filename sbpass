#!/bin/bash
# sbpass — 显示 argosbx-ui 管理员密码；.env 不存在时先生成一个随机密码
# 安装：cp sbpass /usr/local/bin/sbpass && chmod +x /usr/local/bin/sbpass
# 用法：SSH 进 VPS 后直接输 sbpass
cd /root/argosbx-ui || exit 1
[ -f .env ] || { echo ADMIN_PASSWORD=$(cat /proc/sys/kernel/random/uuid) > .env; chmod 600 .env; }
grep ADMIN_PASSWORD .env | cut -d= -f2-
